PI = 3.14
def ploshad(a, b):
    """Считает площадь прямоугольника."""
    return a * b

def circle(r):
    """Считает площадь круга."""
    return PI * r ** 2

a = float(input("Введите ширину прямоугольника: "))
b = float(input("Введите высоту прямоугольника: "))

s1 = ploshad(a, b)
print(f"Площадь прямоугольника: {s1:.2f}")

r = float(input("Введите радиус круга: "))

s2 = circle(r)
print(f"Площадь круга: {s2:.2f}")
