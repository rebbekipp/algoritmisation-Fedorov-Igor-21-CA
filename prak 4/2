import math 
def a(x1, y1, x2, y2):
    dist = math.sqrt((x1 - x2)**2 + (y1 - y2)**2)
    return dist

x1, y1 = map(float, input("координаты первой точки (x y): ").split())
x2, y2 = map(float, input("координаты второй точки (x y): ").split())
dist = a(x1, y1, x2, y2)

print(f"Евклидово расстояние: {dist:.2f}")
