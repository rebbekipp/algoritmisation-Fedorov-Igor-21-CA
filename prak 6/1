temp = int(input("Введите вашу температуру:"))
dawl = int(input("Введите ваше верхнее давление:"))
puls = int(input("Введите ваш пульс:"))
if temp == 35 or temp == 36 and 110 <= dawl <= 130 and 60 <= puls <= 100:
    print("Нормальное состояние")
elif 35 <= temp <= 38 and 105 <= dawl <= 110 or 130 <= dawl <= 140 and 55 <= puls <= 60 or 100 <= puls <= 110:
    print("Легкое недомогание") 
elif temp < 35 or temp > 38 and dawl < 105 or dawl > 140 and puls < 55 or puls > 110:
    print("Требуется врач")
else:
    print("Неверно введеные значения")
