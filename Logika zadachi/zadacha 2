A = int(input())            #вводим два значения, начало диапазона и конец диапазона(на второй строке)
B = int(input())
nechetni = 0                #считают количесвто четных и нечеьных чисел
chetni = 0
for i in range(A, B +1):    #берет диапазон от А до В, если не ннаписать B+1, то он возьмет на значение меньше, чем В
    if i % 2 != 0:          #проверяет является ли число нечетным
        nechetni +=1        #прибавляет к счетчику нечетных чисел единичку 
    else:
        chetni +=1          #прибавляет к счетчику четных чисел единичку 
print(chetni-nechetni)
